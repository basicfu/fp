# 复制成 .env.local 后填入真实值。.env.local 不会被提交。
FP_PG_HOST=10.9.1.2
FP_PG_PORT=15432
FP_PG_USER=postgres
FP_PG_PASSWORD=
FP_REDIS_HOST=10.9.1.2
FP_REDIS_PORT=4379
FP_REDIS_PASSWORD=

# 阿里云短信：只在 FP_ENV=PROD 时四项均为必填（config.Load 会校验，缺任何
# 一项会让生产环境启动失败）。非生产环境（默认 FP_ENV=DEV）允许留空，此时
# 短信走内存假供应商（notify.NewLoggingFakeProvider），验证码不会真的发送，
# 而是以 WARN 级别打进 fp 自己的日志，仅用于本地开发/测试；启动日志会打
# 一条 WARN 提示这一点，不会静默降级。四项在非生产环境下也填齐的话，
# 仍然会使用真实的阿里云供应商。
FP_ALIYUN_ACCESS_KEY_ID=
FP_ALIYUN_ACCESS_KEY_SECRET=
FP_ALIYUN_SMS_SIGN_NAME=
# fp 内部模板 key "login_code" 对应的阿里云短信模板 ID。
FP_ALIYUN_SMS_TEMPLATE_LOGIN_CODE=
# 可选，留空则使用阿里云短信默认接入点（dysmsapi.aliyuncs.com）。
FP_ALIYUN_ENDPOINT=

# examples/demo 用的应用凭据：在管理端创建应用、启用 sms_code 连接器后，
# 从创建应用的响应里取得（appSecret 只在创建时返回一次，之后无法读回）。
# 与 PG/Redis 密码一样是凭据，只能进 git-ignored 的 .env.local；
# 完整步骤见 examples/demo/README.md。
FP_APP_ID=
FP_APP_SECRET=

# fp-im（可选服务）。未设置 FP_IM_REDIS_URL 时复用 FP_REDIS_URL。
# FP_IM_HTTP_ADDR=:8081
# FP_IM_GRPC_ADDR=:9091
# FP_IM_FP_ADDR=localhost:9090
# FP_IM_APPS_FILE=./tmp/im-apps.json   # {"apps":[{"app_id":"…","app_secret":"…","allow_guest":true}]}
# FP_IM_TRUST_PROXY=false
