/fp
/fp.exe
/demo
/demo.exe
/tmp/
.env
.env.local
*.log

# scripts/build.sh / scripts/build-im.sh 编译产物，docker build 完就删了，
# 但手动中断时会留在工作区。
/bootstrap
/bootstrap-upx

# 旧版启动配置文件，含 PG/Redis 密码与阿里云凭据。fp 与 fp-im 都已经不再
# 读它们了（改成环境变量 + fp 数据库里的系统配置表），本机仍可能留着带
# 真实密码的旧文件，继续忽略防止被误提交。
/config.yaml
/config-im.yaml

.idea/

# Claude Code 的本机目录：settings.local.json 是个人配置，worktrees/ 是整份
# 仓库拷贝（数百 MB）。要共享项目级配置（settings.json / launch.json），
# 单独用 ! 放行那一个文件，不要整个目录入库。
.claude/
.superpowers/

# 前端构建产物：由 scripts/build-web.sh 生成，go:embed（web/embed.go）
# 在编译期把它打进二进制，不入库。.gitkeep 占位，保证没跑过 npm 的人
# clone 下来也能 go build ./...（细节见 web/embed.go 顶部注释）。
web/node_modules/
web/dist/*
!web/dist/.gitkeep
